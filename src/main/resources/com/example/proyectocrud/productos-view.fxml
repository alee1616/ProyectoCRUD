<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="804.0" prefWidth="953.0" spacing="15.0" style="-fx-background-color: #F4F6F9; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectocrud.controller.ProductoController">
    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>

    <Label style="-fx-text-fill: #2C3E50; -fx-font-size: 22px; -fx-font-weight: bold; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 2, 0, 0, 1);" text="Gestión de Productos" />

    <GridPane hgap="20.0" style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E4E8; -fx-border-width: 1;" vgap="15.0">
        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtCodigo" promptText="Ej: PRD-001" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7; -fx-padding: 6;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" promptText="Nombre del producto" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7; -fx-padding: 6;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtPrecio" promptText="0.00" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7; -fx-padding: 6;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Stock:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtStock" promptText="0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7; -fx-padding: 6;" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="cmbCategoria" prefWidth="220.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Marca:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <ComboBox fx:id="cmbMarca" prefWidth="220.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7;" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <DatePicker fx:id="dpFecha" prefWidth="220.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Descripción:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <TextField fx:id="txtDescripcion" promptText="Descripción opcional" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7; -fx-padding: 6;" GridPane.columnIndex="3" GridPane.rowIndex="3" />
      <columnConstraints>
         <ColumnConstraints />
         <ColumnConstraints />
         <ColumnConstraints />
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <HBox spacing="15.0">
        <Button fx:id="btnNuevo" onAction="#onNuevo" prefWidth="100.0" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;" text="Nuevo" />
        <Button fx:id="btnGuardar" onAction="#onGuardar" prefWidth="100.0" style="-fx-background-color: #2ECC71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;" text="Guardar" />
        <Button fx:id="btnActualizar" onAction="#onActualizar" prefWidth="100.0" style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;" text="Actualizar" />
        <Button fx:id="btnEliminar" onAction="#onEliminar" prefWidth="100.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;" text="Eliminar" />
    </HBox>

    <Label style="-fx-text-fill: #2C3E50; -fx-font-size: 20px; -fx-font-weight: bold; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.1), 2, 0, 0, 1);" text="Búsqueda y Filtros">
        <VBox.margin>
            <Insets top="15.0" />
        </VBox.margin>
    </Label>

    <GridPane hgap="20.0" style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E4E8; -fx-border-width: 1;" vgap="15.0">
        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Código o nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtBuscarCodigoNombre" promptText="Buscar..." style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7; -fx-padding: 6;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Categoría:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <ComboBox fx:id="cmbBuscarCategoria" prefWidth="220.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Desde:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <DatePicker fx:id="dpBuscarDesde" prefWidth="220.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Hasta:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <DatePicker fx:id="dpBuscarHasta" prefWidth="220.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7;" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Precio mínimo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtBuscarPrecioMin" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7; -fx-padding: 6;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Precio máximo:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="txtBuscarPrecioMax" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7; -fx-padding: 6;" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <CheckBox fx:id="chkSoloExistencias" style="-fx-text-fill: #34495E; -fx-font-size: 13px; -fx-font-weight: bold;" text="Solo productos con existencias" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3" />

        <Label style="-fx-text-fill: #34495E; -fx-font-weight: bold; -fx-font-size: 13px;" text="Ordenar por:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <ComboBox fx:id="cmbOrdenarPor" prefWidth="220.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #BDC3C7;" GridPane.columnIndex="3" GridPane.rowIndex="3" />
      <columnConstraints>
         <ColumnConstraints />
         <ColumnConstraints />
         <ColumnConstraints />
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <HBox spacing="15.0">
        <Button fx:id="btnBuscar" onAction="#onBuscarAction" prefWidth="120.0" style="-fx-background-color: #8E44AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;" text="Buscar" />
        <Button fx:id="btnLimpiarFiltros" onAction="#onLimpiarFiltrosAction" prefWidth="120.0" style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;" text="Limpiar filtros" />
    </HBox>

    <TableView fx:id="tblProductos" prefHeight="120.0" prefWidth="890.0" style="-fx-font-size: 13px; -fx-border-color: #E0E4E8; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="130.0" text="Categoría" />
            <TableColumn fx:id="colMarca" prefWidth="130.0" text="Marca" />
            <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
            <TableColumn fx:id="colFecha" prefWidth="130.0" text="Fecha creación" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
